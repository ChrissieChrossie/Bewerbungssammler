meta {
  name: Create User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/users/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "jdoe",
    "name": "John Doe",
    "email": "jdoe@example.com"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("userId", res.body.id);
  }
}
