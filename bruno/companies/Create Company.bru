meta {
  name: Create Company
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/companies/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Acme GmbH",
    "homepage": "https://acme.example.com"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("companyId", res.body.id);
  }
}
