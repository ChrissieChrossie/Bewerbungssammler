# Lokale Entwicklung: SQLite (Standard, kein Setup nötig)
DATABASE_URL=sqlite:///./bewerbungssammler.db

# AWS RDS (PostgreSQL) – später befüllen:
# DATABASE_URL=postgresql://USER:PASSWORD@your-rds-endpoint.eu-central-1.rds.amazonaws.com:5432/bewerbungssammler

# --- Auth ---

# Secret zum Signieren der JWT-Access-Tokens. Niemals hartcodieren oder committen.
# Lokal beliebig setzen, in Produktion einen langen Zufallswert generieren, z.B.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-value

# Lebensdauer Access-Token (Minuten) / Refresh-Token (Tage)
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# bcrypt-Cost-Faktor für das Passwort-Hashing (min. 12 empfohlen)
BCRYPT_ROUNDS=12

# Origin des Frontends, für CORS (nur relevant, wenn Frontend/Backend nicht über
# den Vite-Dev-Proxy, sondern direkt cross-origin miteinander sprechen)
FRONTEND_ORIGIN=http://localhost:5173

# Auth-Cookies nur über HTTPS senden. Lokal (HTTP) auf false lassen, in Produktion true setzen.
COOKIE_SECURE=false

# Rate Limits für Login/Registrierung (slowapi-Syntax, z.B. "5/minute")
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=5/minute
